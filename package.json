{
  "name": "nova",
  "private": true,
  "version": "0.1.0",
  "description": "Nova - a voice-controlled personal computer agent for Windows",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "models": "node scripts/fetch-models.mjs",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:agent": "cargo test --manifest-path src-tauri/Cargo.toml --test common_instructions -- --nocapture",
    "test:speech": "cargo test --manifest-path src-tauri/Cargo.toml -- --ignored --nocapture",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.6.3",
    "vite": "^8.3.4"
  }
}
