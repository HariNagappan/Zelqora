# ── Nova configuration ────────────────────────────────────────────────
# Copy this file to `.env` and fill in values as needed.
#
# Everything here is OPTIONAL: Nova runs fully offline by default
# (local wake word + local speech-to-text + rule-based command parsing).
# Values configured in the Nova Settings UI take precedence over this file,
# except for the API key which falls back to this file when not set in the UI.

# OpenAI-compatible AI provider (enables natural-language tool calling).
# Any OpenAI-compatible endpoint works (OpenAI, compatible gateways,
# or a local server such as Ollama / LM Studio with an OpenAI API shim).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: override where Nova looks for the local whisper model.
# Default search order: this env var → Nova app-data dir → `<repo>/models`.
# NOVA_MODELS_DIR=C:\path\to\models
